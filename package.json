{
  "name": "@khaister/expressive-code-word-wrap",
  "version": "0.1.0",
  "description": "An Expressive Code plugin that adds a button to manually toggle word wrap on individual code blocks.",
  "keywords": [
    "expressive-code",
    "expressive-code-plugin",
    "word-wrap",
    "line-wrap",
    "astro"
  ],
  "license": "MIT",
  "author": "Khai Nguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khaister/expressive-code-word-wrap.git"
  },
  "homepage": "https://github.com/khaister/expressive-code-word-wrap#readme",
  "bugs": {
    "url": "https://github.com/khaister/expressive-code-word-wrap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup ./src/index.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup ./src/index.ts --format esm --dts --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@expressive-code/core": "^0.40.0"
  },
  "devDependencies": {
    "@expressive-code/core": "^0.44.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
